version: '3.8'

services:
  local-codespace:
    image: ://microsoft.com
    container_name: high_perf_codespace
    volumes:
      - ..:/workspace:cached
    environment:
      - NVIDIA_VISIBLE_DEVICES=all
      - NVIDIA_DRIVER_CAPABILITIES=compute,utility
    # Atribui os recursos de Hardware solicitados (RTX 3060 + RAM)
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
        limits:
          memory: 32gb
    # Mantém o contêiner rodando em segundo plano
    command: sleep infinity
